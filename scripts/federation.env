# Committed launch defaults for `npm run serve` (scripts/serve.mjs).
#
# Why this file exists: this app shells out to a binary named by BD_BIN
# (lib/bd.ts), defaulting to plain `bd` on PATH when unset. On machines where
# `bd` is a *federation wrapper* that routes between multiple issue stores,
# running it with no store context just prints a store-selection menu and
# does nothing useful — it never reaches this app's actual command. BD_BIN
# must point at the real, single-store `beads` binary instead. See the
# "Durable production launch" section in README.md for the full story.
#
# These are DEFAULTS ONLY. scripts/serve.mjs loads this file without
# overriding anything already present in the environment, so a real exported
# var (or `BD_BIN=... npm run serve`) always wins — another machine or user
# is never stuck with these paths. $HOME is expanded to the current user's
# home directory; no other shell syntax is supported.

# Real single-store beads binary — NOT the `bd` federation wrapper on PATH.
BD_BIN=$HOME/.local/bin/beads

# Store directory read by the real `beads` binary itself (via BD_BIN) when
# invoked outside the federation wrapper's normal routing. Not read by this
# app's own source — see lib/config.ts / BEADS_REPO for this app's repo path.
BEADS_DIR=$HOME/data/tasks/.beads

# Structured output, read by lib/bd.ts.
BD_JSON_ENVELOPE=1

# Bind all interfaces so phones/other devices on the LAN or Tailscale can
# reach this box, not just localhost.
HOST=0.0.0.0
